# FlagFinder environment. Copy to .env (and apps/web/.env.local for the web app).
# [required] must be set · [optional] unlocks a feature; the fallback is described · [browser] exposed to the browser

# --- Core ---
# [required] Postgres 16 + PostGIS + pg_trgm
DATABASE_URL=postgres://flagfinder:flagfinder@localhost:5432/flagfinder
# [required] public base URL (links in emails, canonical URLs, MapKit token origin)
APP_BASE_URL=http://localhost:3000
# [required in production] development | test | staging | production. Production-only behavior keys off this,
# because Next.js always builds with NODE_ENV=production.
APP_ENV=development
# [required in production] Better Auth secret (32+ random bytes). Rotating it signs everyone out.
AUTH_SECRET=
# [optional] show SYNTHETIC demo data (with DEMO badges) outside production. Always off in production.
SHOW_DEMO_DATA=on

# --- Maps --- (none configured → full list + "Open in Google/Apple Maps" + directions links, no embedded map)
# [optional][browser] Google Maps JS key. Restrict by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# [optional][browser] Google Map ID (enables vector map styling)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# [optional] Apple MapKit JS (token signed server-side at /api/mapkit-token; key never sent to the browser)
MAPKIT_TEAM_ID=
MAPKIT_KEY_ID=
MAPKIT_PRIVATE_KEY=
# [optional] auto | google | apple | none | test-dom (test-dom is a TEST-ONLY renderer, refused in production)
NEXT_PUBLIC_MAP_PROVIDER=auto

# --- Geocoding / routing / discovery ---
# [optional] none | google | apple — GAP: adapters not implemented; unknown coordinates stay unknown
GEOCODER_PROVIDER=none
# [optional] none | google — without it, distances are labeled "straight-line distance"
ROUTING_PROVIDER=none
# [optional] none | brave — GAP: adapter not implemented
SEARCH_API_PROVIDER=none
SEARCH_API_KEY=

# --- AI-assisted extraction --- (no key → unstructured submissions and flyers go to manual review)
# [optional] Anthropic API key (worker only)
ANTHROPIC_API_KEY=
# [optional] model id; extraction runs at low effort with structured output and no tools
LLM_MODEL=claude-opus-5-5
# [optional] monthly circuit breaker in USD
LLM_MONTHLY_BUDGET_USD=25
# [optional] per-call output token cap
LLM_MAX_TOKENS_PER_CALL=2000

# --- Email --- (default: outbox catcher table `email_outbox`; nothing is delivered)
# [optional] outbox | smtp (local catcher like Mailpit only, outside production) | production
EMAIL_TRANSPORT=outbox
# [optional] e.g. smtp://localhost:1025 for Mailpit (docker compose up)
SMTP_URL=
EMAIL_FROM=FlagFinder <alerts@flagfinder.example>

# --- Facebook Pages (pending Meta App Review) ---
# [optional] on | off
FEATURE_FACEBOOK_PAGES=off
META_APP_ID=
META_APP_SECRET=

# --- Ops ---
# [optional] Sentry-compatible DSN (GAP: logs JSON only)
SENTRY_DSN=
# [optional] consecutive failures before alert + circuit breaker
SOURCE_FAILURE_ALERT_THRESHOLD=5
# [optional] private upload directory (not web-served)
STORAGE_DIR=.data/uploads
# [optional] scheduler tick and hourly fetch capacity shared by the 60/25/15 budget
SCHEDULER_TICK_SECONDS=60
SCHEDULER_HOURLY_CAPACITY=120

# Max DB connections per pool (web, worker, each pg-boss). Use 3 on free hosted Postgres.
DB_POOL_MAX=10
