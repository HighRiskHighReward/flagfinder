# Long-running worker and scheduler (same image, different command). Not serverless.
FROM node:22-bookworm-slim
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production APP_ENV=production
# worker: CMD ["pnpm","worker"]  ·  scheduler: override with ["pnpm","scheduler"] (run exactly one)
CMD ["pnpm", "worker"]
