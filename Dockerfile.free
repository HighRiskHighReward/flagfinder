# Free-tier single container (ADR-022): web + combined worker/scheduler, migrations at start.
FROM node:22-bookworm-slim
RUN corepack enable && corepack prepare pnpm@10.28.0 --activate
WORKDIR /app
COPY . .
RUN pnpm install --frozen-lockfile && pnpm --filter @ff/web build
ENV NODE_ENV=production APP_ENV=production PORT=3000 DB_POOL_MAX=3 NODE_OPTIONS=--max-old-space-size=200
EXPOSE 3000
CMD ["sh", "scripts/start-all.sh"]
